{
  "name": "oncothreads",
  "version": "0.1.0",
  "author": "Qianwen Wang, Theresa Harbig, Sabrina Nusrat",
  "description": "Visualization of longitudinal cancer genomics data",
  "private": true,
  "dependencies": {
    "antd": "^4.2.4",
    "axios": "^1.6.0",
    "d3": "^7.9.0",
    "d3-lasso": "github:skokenes/d3-lasso",
    "d3-sankey": "^0.12.3",
    "d3-scale-chromatic": "^1.5.0",
    "electron-is-dev": "^1.2.0",
    "html2canvas": "^1.0.0-rc.5",
    "intro.js": "^2.9.3",
    "jquery": "^3.5.1",
    "lineupjs": "^3.3.0",
    "lineupjsx": "^1.0.7",
    "ml-pca": "^4.0.1",
    "mobx": "^6.12.0",
    "mobx-react": "^9.1.0",
    "mobx-utils": "^6.0.8",
    "papaparse": "^5.2.0",
    "prop-types": "^15.7.2",
    "re-resizable": "^6.11.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.10",
    "react-color": "^2.18.1",
    "react-dom": "^18.2.0",
    "react-fontawesome": "^1.7.1",
    "react-grid-layout": "^1.2.0",
    "react-select": "^3.1.0",
    "react-sortable-pane": "^1.1.0",
    "@keckelt/tsne": "^1.0.2",
    "umap-js": "^1.3.3",
    "uuid": "^9.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build-web": "vite build --mode production",
    "build-electron": "VITE_ELECTRON=true vite build",
    "preview": "vite preview",
    "electron-start": "concurrently \"cross-env BROWSER=none VITE_ELECTRON=true npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "publish-mac-win": "npm run build-electron && electron-builder --publish=always --mac --win",
    "publish-currentOS": "npm run build-electron && electron-builder --publish=always",
    "test": "echo 'No tests configured yet'"
  },
  "homepage": ".",
  "main": "public/electron.js",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "build": {
    "appId": "com.github.hms-dbmi.oncothreads",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "snap": {
      "publish": [
        "github"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hms-dbmi",
        "repo": "OncoThreads"
      }
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "devDependencies": {
    "@types/d3": "^5.7.2",
    "@types/d3-sankey": "^0.11.0",
    "@types/intro.js": "^2.4.7",
    "@types/react-grid-layout": "^1.1.1",
    "@types/uuid": "^8.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^4.1.0",
    "cross-env": "^6.0.3",
    "electron": "^11.5.0",
    "electron-builder": "^21.2.0",
    "eslint-config-airbnb": "^18.1.0",
    "jspdf": "^1.5.3",
    "popper.js": "^1.16.1",
    "tslib": "^2.0.1",
    "typescript": "^3.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^3.2.0"
  }
}